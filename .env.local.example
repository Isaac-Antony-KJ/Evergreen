# Copy this file to .env.local and fill in your Supabase project's values.
# Find both under Project Settings -> API Keys in the Supabase dashboard.
#
# Neither variable is prefixed with NEXT_PUBLIC_ on purpose: this app never
# talks to Supabase from the browser. Every database read and write happens
# in server code (Server Components, Server Actions, and the /calendar/[token]
# route), so the secret key is never bundled into client-side JavaScript.

# Project URL, e.g. https://abcdefghijkl.supabase.co
SUPABASE_URL=

# Secret key (starts with sb_secret_...). This bypasses Row Level Security,
# so treat it like a password. If your project still shows only legacy keys,
# the "service_role" key works the same way here.
SUPABASE_SECRET_KEY=
